DATA_PATH=./data

PORT=8080

# RESEARCH_TOPIC: topic to research on container start.
# RESEARCH_TOPIC=AI agents

# SOURCES: comma-separated source keys shown in the UI. Leave empty to show all.
# SOURCES=reddit,x,youtube,hackernews,github,polymarket,web

# SCRAPECREATORS_API_KEY: required for reliable Reddit/TikTok/LinkedIn results
# (keyless Reddit is rate-limited to 429). Also enables those sources in the UI.
# SCRAPECREATORS_API_KEY=your_key_here

# RESEARCH_INTERVAL_HOURS: re-run research on a schedule.
# RESEARCH_INTERVAL_HOURS=6